@model List<SharedLibrary.Models.Case>

@{
}


<p> STUDENT!!!</p>

@foreach (var medCase in Model)
{
    <form asp-controller="Home" asp-action="AddUser" method="post">
        <p>Navn: @medCase.Patient.Name Alder: @medCase.Patient.Age Kjonn: @medCase.Patient.Gender</p>
        <p>Vitals: </p>
        <p>Blodtrykk: @medCase.Vitals.BlodPressure()</p>
        <p>Puls: @medCase.Vitals.Pulse</p>
        <p>Oksygenmetning: @medCase.Vitals.OxygenSaturation</p>
        <p>Temperatur: @medCase.Vitals.Temperature</p>
        <p>Vannskelighetsgrad: @medCase.Difficulty </p>
        <p>Bruker: @medCase.User</p>

        <input type="hidden" name="caseid" value="@medCase.Id" />
        <button type="submit"> Velg case </button>
    </form>

}