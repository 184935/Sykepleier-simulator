<Window x:Class="StudSim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudSim"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="start" Content=" Start " Margin="10,13,0,0" Click="start_Click" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Label x:Name="navn" Content="Navn:" HorizontalAlignment="Left" Margin="92,10,0,0" VerticalAlignment="Top" Width="150"/>
        <Label x:Name="age" Content="Alder: " HorizontalAlignment="Left" Margin="262,10,0,0" VerticalAlignment="Top" Width="60"/>
        <Label x:Name="gender" Content="Kjonn: " HorizontalAlignment="Left" Margin="336,10,0,0" VerticalAlignment="Top" Width="80"/>
        <Label x:Name="weight" Content="Vekt: " HorizontalAlignment="Left" Margin="432,10,0,0" VerticalAlignment="Top" Width="60"/>
        <Button x:Name="history" Content=" Historikk " HorizontalAlignment="Left" Margin="546,13,0,0" VerticalAlignment="Top" Click="history_Click"/>
        <Button x:Name="diagnosis" Content=" Diagnoser " HorizontalAlignment="Left" Margin="620,13,0,0" VerticalAlignment="Top" Click="diagnosis_Click"/>
        <ListView Name="Logg" HorizontalAlignment="Left" Height="207" Margin="467,217,0,0" VerticalAlignment="Top" Width="327" ItemsSource="{Binding}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="85" Header="Tidspunkt" DisplayMemberBinding="{Binding Path=Timestamp}"/>
                    <GridViewColumn Width="242" Header="Hendelse" DisplayMemberBinding="{Binding Path=Action}" />
                </GridView>
            </ListView.View>
        </ListView>
        <ListView Name="medList" HorizontalAlignment="Left" Height="207" Margin="10,217,0,0" VerticalAlignment="Top" Width="452" ItemsSource="{Binding}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="100" Header="Navn" DisplayMemberBinding="{Binding Path=Name}" />
                    <GridViewColumn Width="40" Header="Dose" DisplayMemberBinding="{Binding Path=Dose}" />
                    <GridViewColumn Width="50" Header="Admin" DisplayMemberBinding="{Binding Path=Route}" />
                    <GridViewColumn Width="75" Header="Frekvens" DisplayMemberBinding="{Binding Path=Frequency}" />
                    <GridViewColumn Width="187" Header="Notater" DisplayMemberBinding="{Binding Path=Notes}" />
                </GridView>
            </ListView.View>
        </ListView>
        <Button x:Name="givemeds" Click="givemeds_Click" Content=" Gi medisin " HorizontalAlignment="Left" Margin="657,91,0,0" VerticalAlignment="Top"/>
        <Button x:Name="giveiv" Click="giveiv_Click" Content=" Gi intravanøst " HorizontalAlignment="Left" Margin="568,91,0,0" VerticalAlignment="Top"/>
        <Button x:Name="giveblanket" Click="giveblanket_Click" Content=" Ta på teppe " HorizontalAlignment="Left" Margin="618,131,0,0" VerticalAlignment="Top"/>
        <Button x:Name="cooldown" Click="cooldown_Click" Content=" Avkjøl " HorizontalAlignment="Left" Margin="568,131,0,0" VerticalAlignment="Top"/>
        <Label Content="Medisiner" HorizontalAlignment="Left" Margin="11,191,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label Content="Logg" HorizontalAlignment="Left" Margin="467,191,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label Content="Labb verdier" HorizontalAlignment="Left" Margin="10,55,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label x:Name="bloodsugar" Content="Blodsukker: " HorizontalAlignment="Left" Margin="10,86,0,0" VerticalAlignment="Top" Width="90"/>
        <Label x:Name="creatinine" Content="Kreatinin: " HorizontalAlignment="Left" Margin="10,115,0,0" VerticalAlignment="Top" Width="76"/>
        <Label x:Name="sodium" Content="Natrium: " HorizontalAlignment="Left" Margin="105,86,0,0" VerticalAlignment="Top" Width="85"/>
        <Label x:Name="potassium" Content="Kalium: " HorizontalAlignment="Left" Margin="105,115,0,0" VerticalAlignment="Top" Width="85"/>
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="101" Margin="10,55,0,0" VerticalAlignment="Top" Width="199"/>
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="23" Margin="92,13,0,0" VerticalAlignment="Top" Width="412"/>
        <Button x:Name="allergies" Content=" Allergier " HorizontalAlignment="Left" Margin="702,13,0,0" VerticalAlignment="Top" Click="allergies_Click"/>
        <Label Content="Vitale verdier" HorizontalAlignment="Left" Margin="236,55,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label x:Name="bloodpressure" Content="Blodtrykk: " HorizontalAlignment="Left" Margin="237,86,0,0" VerticalAlignment="Top" Width="116"/>
        <Label x:Name="puls" Content="Puls: " HorizontalAlignment="Left" Margin="237,115,0,0" VerticalAlignment="Top" Width="61"/>
        <Label x:Name="respfreq" Content="Respirasjonsfrekvens: " HorizontalAlignment="Left" Margin="237,146,0,0" VerticalAlignment="Top" Width="164"/>
        <Label x:Name="o2" Content="O2-metning: " HorizontalAlignment="Left" Margin="358,86,0,0" VerticalAlignment="Top" Width="120"/>
        <Label x:Name="temp" Content="Temperatur: " HorizontalAlignment="Left" Margin="358,115,0,0" VerticalAlignment="Top" Width="120"/>
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="117" Margin="231,55,0,0" VerticalAlignment="Top" Width="254"/>
        <Label Content="Handlinger" HorizontalAlignment="Left" Margin="566,55,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="104" Margin="561,55,0,0" VerticalAlignment="Top" Width="196" />

    </Grid>
</Window>
