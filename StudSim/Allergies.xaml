<Window x:Class="StudSim.Allergies"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudSim"
        mc:Ignorable="d"
        Title="Allergies" Height="450" Width="800">
    <Grid>
        <ListView Name="Allergylist" HorizontalAlignment="Center" Height="414" VerticalAlignment="Center" Width="780" ItemsSource="{Binding}">
            <ListView.View>
                <GridView>
                    <GridView.Columns>
                        <GridViewColumn Width="120" Header="Allergen" DisplayMemberBinding="{Binding Path=Allergen}" />
                        <GridViewColumn Width="660" Header="Reaction" DisplayMemberBinding="{Binding Path=Reaction}" />
                    </GridView.Columns>
                </GridView>
            </ListView.View>
        </ListView>

    </Grid>
</Window>
