<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TeacherOverview.Views.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label
                Text="Simulation view!"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Button Text="Se live simulering" Clicked="SimButton_Clicked" />
            <Button Text="Debrief" Clicked="DebriefButton_Clicked"/>

            <Button Text="Kommentar" Clicked="CommentButton_Clicked" />
            <Entry x:Name="kommentarfelt"
                IsVisible="False"
                Placeholder="Skriv kommentar"
                Completed="CommentEntry_Completed"/>
            
            <CollectionView x:Name="Eventlogg">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout  Padding="10">
                            <Label Text="{Binding Timestamp}" />
                            <Label Text="{Binding Action}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>


        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
